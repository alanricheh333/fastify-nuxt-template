{
  "name": "fastify-nuxt-template",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "architecture:check": "depcruise --config .dependency-cruiser.cjs apps/api/src apps/web/app",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "validate": "pnpm typecheck && pnpm lint && pnpm architecture:check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "dependency-cruiser": "latest",
    "turbo": "latest"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10"
}
