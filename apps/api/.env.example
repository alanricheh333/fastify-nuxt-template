# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=debug

# CORS
# Copy this file to .env for local development as-is.
# The default Nuxt dev server is expected at http://localhost:3000.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=false

# Rate limiting
# Generous global default for a single API instance.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_SSL=false
